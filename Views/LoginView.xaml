<Window
    x:Class="EVotingSystem.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:EVotingSystem.ViewModels"
    Title="Prijava"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Grid>
        <materialDesign:Card
            Width="450"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            materialDesign:ElevationAssist.Elevation="Dp4"
            UniformCornerRadius="10">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    Text="Prijava na Sistem" />

                <StackPanel Visibility="{Binding IsStepOneVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="Bold"
                        Text="KORAK 1: Digitalni sertifikat" />
                    <Button
                        Margin="0,0,0,10"
                        Command="{Binding SelectCertificateCommand}"
                        Content="Odaberi .p12 sertifikat"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="11"
                        Foreground="Gray"
                        Text="{Binding SelectedCertificatePath}"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        x:Name="CertPasswordBox"
                        Margin="0,0,0,25"
                        materialDesign:HintAssist.Hint="Lozinka sertifikata"
                        Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />
                    <Button
                        Height="45"
                        Command="{Binding ValidateCertificateCommand}"
                        CommandParameter="{Binding ElementName=CertPasswordBox}"
                        Content="Validiraj sertifikat"
                        FontSize="16" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsStepTwoVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="Bold"
                        Text="KORAK 2: Kredencijali naloga" />
                    <TextBox
                        Margin="0,0,0,15"
                        materialDesign:HintAssist.Hint="Korisničko ime"
                        FontSize="16"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding Username}" />
                    <PasswordBox
                        x:Name="AppPasswordBox"
                        Margin="0,0,0,25"
                        materialDesign:HintAssist.Hint="Lozinka naloga"
                        Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />
                    <Button
                        Height="45"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=AppPasswordBox}"
                        Content="PRIJAVI SE"
                        FontSize="16"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

                <Button
                    Margin="0,20,0,0"
                    Command="{Binding GoToRegisterCommand}"
                    Content="Nemate nalog? Registrujte se"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>