<Window
    x:Class="EVotingSystem.Views.Organizer.OrganizerDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Organizator Dashboard"
    Width="900"
    Height="700"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <TabControl>
            <TabItem Header="Kreiraj glasanje">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="600" Margin="40">
                            <TextBlock
                                Margin="0,0,0,30"
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Text="Kreiranje Novog Glasanja" />

                            <TextBox
                                Margin="0,0,0,20"
                                materialDesign:HintAssist.Hint="Naslov glasanja"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding ElectionTitle}" />

                            <TextBox
                                Height="100"
                                Margin="0,0,0,20"
                                materialDesign:HintAssist.Hint="Opis glasanja"
                                AcceptsReturn="True"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding ElectionDescription}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                <DatePicker
                                    Width="250"
                                    Margin="0,0,20,0"
                                    materialDesign:HintAssist.Hint="Datum početka"
                                    SelectedDate="{Binding StartDate}"
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />

                                <DatePicker
                                    Width="250"
                                    materialDesign:HintAssist.Hint="Datum završetka"
                                    SelectedDate="{Binding EndDate}"
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                            </StackPanel>

                            <TextBox
                                Margin="0,0,0,30"
                                materialDesign:HintAssist.HelperText="Primjer: Opcija 1, Opcija 2, Opcija 3"
                                materialDesign:HintAssist.Hint="Kandidati/Opcije (odvojeni zarezom)"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding CandidatesInput}" />

                            <Button
                                Width="250"
                                Height="45"
                                HorizontalAlignment="Center"
                                Command="{Binding CreateElectionCommand}"
                                Content="KREIRAJ GLASANJE"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Moja glasanja">
                <Grid Background="#F5F5F5">
                    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MyElections}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MyElections.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <TextBlock
                                                            Margin="0,50,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="18"
                                                            Foreground="Gray"
                                                            Text="Trenutno nemate kreiranih glasanja." />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card
                                        Margin="10"
                                        Padding="20"
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        UniformCornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock
                                                    FontSize="22"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    Text="{Binding Title}" />
                                                <TextBlock
                                                    Margin="0,10,0,15"
                                                    FontSize="14"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />

                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="Gray"
                                                        Kind="CalendarClock" />
                                                    <TextBlock
                                                        Margin="0,0,20,0"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding StartDate, StringFormat='Početak: {0:dd.MM.yyyy}'}" />

                                                    <materialDesign:PackIcon
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="Gray"
                                                        Kind="CalendarCheck" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding EndDate, StringFormat='Kraj: {0:dd.MM.yyyy}'}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IsActive, StringFormat='Aktivno: {0}'}" Visibility="Collapsed" />

                                                <Button
                                                    Height="40"
                                                    Command="{Binding DataContext.CountVotesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="PREBROJ GLASOVE"
                                                    IsEnabled="{Binding IsFinished}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" />

                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="Gray"
                                                    Text="Dostupno tek po završetku" />
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>