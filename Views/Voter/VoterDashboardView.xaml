<Window
    x:Class="EVotingSystem.Views.Voter.VoterDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Glasač Dashboard"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  SEKCIJA ZA VERIFIKACIJU GLASA  -->
                <materialDesign:Card
                    Margin="20,10,20,20"
                    Padding="15"
                    Background="#E8F5E9"
                    UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#2E7D32"
                            Text="Verifikacija upisanog glasa" />
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="12"
                            Text="Unesite kod (Receipt) koji ste dobili prilikom glasanja da biste provjerili da li je vaš glas sigurno u bazi."
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <TextBox
                                Width="350"
                                Margin="0,0,15,0"
                                materialDesign:HintAssist.Hint="Unesite vaš kod za verifikaciju ovdje..."
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding ReceiptInput}" />
                            <Button
                                BorderBrush="#2E7D32"
                                Command="{Binding VerifyMyVoteCommand}"
                                Content="VERIFIKUJ"
                                Foreground="#2E7D32"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <Separator Margin="20,0,20,10" />
                <TextBlock
                    Margin="20,10,20,20"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="Aktivna glasanja" />

                <ItemsControl ItemsSource="{Binding ActiveElections}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveElections.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBlock
                                                    Margin="0,50,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="18"
                                                    Foreground="Gray"
                                                    Text="Trenutno nema aktivnih glasanja na kojima niste glasali." />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card
                                Margin="10,0,10,20"
                                Padding="25"
                                materialDesign:ElevationAssist.Elevation="Dp2"
                                UniformCornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Naslov i Opis  -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="14"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#E53935"
                                                Kind="TimerSand" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#E53935"
                                                Text="{Binding EndDate, StringFormat='Glasanje se zatvara: {0:dd.MM.yyyy u HH:mm}'}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Opcije za glasanje  -->
                                    <ItemsControl
                                        Grid.Row="1"
                                        Margin="0,0,0,20"
                                        ItemsSource="{Binding Candidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton
                                                    Margin="0,5,0,5"
                                                    Content="{Binding Name}"
                                                    FontSize="16"
                                                    GroupName="{Binding DataContext.Id, RelativeSource={RelativeSource AncestorType=materialDesign:Card}}"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button
                                        Grid.Row="2"
                                        Width="200"
                                        Height="40"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="GLASAJ" />
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>